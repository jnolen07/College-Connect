VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-side only (used by the /api serverless functions, never exposed to
# the browser) -- see README.md section 4 for where these come from. Not
# needed for `npm run dev`, which doesn't run the /api functions at all.
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_PRICE_ID=your-stripe-price-id-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
